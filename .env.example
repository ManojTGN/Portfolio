# Generate the Ed25519 private key (base64-encoded PKCS#8 PEM):
#   node -e "const c=require('crypto');const{privateKey}=c.generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"

# Generate the pepper (random bytes mixed into the code hash):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_OTP_PRIVATE_KEY = "BASE64-ENCODED ED25519 PKCS#8 PEM (used to sign verification JWTs)"
EMAIL_OTP_PEPPER = "RANDOM 32+ BYTE BASE64URL STRING (mixes into code hash)"

YOUTUBE_API_KEY = "YOUTUBE DATA API V3 KEY"
GITHUB_API_TOKEN = "GITHUB REPO READ ACCESS TOKEN"
