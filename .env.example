PORTFOLIO_MAIL_ADDR = "GMAIL USER NAME (the From: address, also the SMTP login)"
PORTFOLIO_MAIL_PASS = "GMAIL APP PASSWORD"
PORTFOLIO_MAIL_TO   = "OWNER INBOX ADDRESS (where contact-form messages are delivered"

# Without the site key the widget is skipped and the contact form cannot be
# submitted, by design. For local work you can use Google's published v2 test
# keys, which always verify and are not secrets:
#   NEXT_PUBLIC_RECAPTCHA_SITE_KEY = "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
#   RECAPTCHA_SECRET_KEY           = "6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe"
# Leave RECAPTCHA_EXPECTED_HOSTNAME unset locally; the hostname check is
# skipped when it is empty, and the test keys do not report your domain.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY = "GOOGLE RECAPTCHA SITE KEY"
RECAPTCHA_SECRET_KEY = "GOOGLE RECAPTCHA SECRET KEY"
RECAPTCHA_EXPECTED_HOSTNAME = "your-portfolio-domain.com"

# Generate the Ed25519 private key (base64-encoded PKCS#8 PEM):
#   node -e "const c=require('crypto');const{privateKey}=c.generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"

# Generate the pepper (random bytes mixed into the code hash):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_OTP_PRIVATE_KEY = "BASE64-ENCODED ED25519 PKCS#8 PEM (used to sign verification JWTs)"
EMAIL_OTP_PEPPER = "RANDOM 32+ BYTE BASE64URL STRING (mixes into code hash)"

YOUTUBE_API_KEY = "YOUTUBE DATA API V3 KEY"
GITHUB_API_TOKEN = "GITHUB REPO READ ACCESS TOKEN"
